# Copy with `npm run env:init` — it creates .env with random secrets filled in.
# Never commit .env.

# ---- Secrets ------------------------------------------------------------
# Same value for auth (signs tokens) and gateway (verifies them).
# Services refuse to start if it is missing, shorter than 32 chars, or this placeholder.
JWT_SECRET=change-me-to-a-long-random-string
# Shared by every service; internal TCP messages without it are rejected.
INTERNAL_TOKEN=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ---- First admin ----------------------------------------------------------
# Created by the auth service on startup if the account doesn't exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Admin
# Public self-registration. Defaults to false when NODE_ENV=production.
ALLOW_REGISTRATION=true

COMPANY_TZ=Asia/Phnom_Penh

# ---- Databases: one per service ---------------------------------------
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db
SHIFT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shift_db
ATTENDANCE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_db
NOTIFICATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notification_db

# Docker Compose only: each service gets its own database user with these passwords.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
AUTH_DB_PASSWORD=change-me-to-a-long-random-string
SHIFT_DB_PASSWORD=change-me-to-a-long-random-string
ATTENDANCE_DB_PASSWORD=change-me-to-a-long-random-string
NOTIFICATION_DB_PASSWORD=change-me-to-a-long-random-string

# ---- Where services live (defaults shown) -----------------------------
PORT=3000
GATEWAY_EVENTS_PORT=4000
AUTH_PORT=4001
SHIFT_PORT=4002
ATTENDANCE_PORT=4003
NOTIFICATION_PORT=4004
STATS_PORT=4005
# Hosts default to 127.0.0.1. In Docker Compose they are the service names.
# AUTH_HOST=auth
# Internal TCP listeners bind to 127.0.0.1 unless BIND_HOST is set.
# BIND_HOST=0.0.0.0

# ---- Kafka ------------------------------------------------------------------
# Comma-separated brokers. Locally: `npm run kafka:up` starts one on localhost:9092
# (and kafka-ui on http://localhost:8080). In Docker Compose it is kafka:19092.
KAFKA_BROKERS=localhost:9092
# Used when topics are created (first start). Changing them later needs kafka-topics.sh.
KAFKA_PARTITIONS=3
KAFKA_RETENTION_DAYS=30
# How many times a consumer retries an event before sending it to <group>.dlq.
KAFKA_HANDLER_ATTEMPTS=3

# ---- HTTP edge ----------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
# Unset: any origin in development, none (same-origin) in production.
# CORS_ORIGINS=https://attendance.example.com
# Set when behind a proxy/load balancer so rate limits see the real client IP.
# TRUST_PROXY=1

# ---- Timeouts ---------------------------------------------------------
RPC_TIMEOUT_MS=5000
SHIFT_TIMEOUT_MS=2000

# ---- Telegram (optional) -----------------------------------------------
# Without a token, notifications are only logged to the console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
