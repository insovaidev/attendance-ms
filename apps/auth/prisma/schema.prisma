// Auth service — owns users and credentials. No other service reads this DB.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EMPLOYEE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Transactional outbox: events written in the same transaction as the change
// that caused them, then delivered by OutboxRelay (libs/common/src/outbox.ts).
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @db.Uuid
  eventName     String
  destination   String
  payload       Json
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedUntil   DateTime?
  publishedAt   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@unique([eventId, destination])
  @@index([publishedAt, nextAttemptAt])
}
